<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer (android:dataExtractionRules): D-472. The same allowlist as
  backup_rules.xml, for a cloud backup and for a transfer to a new phone alike: only
  the SharedPreferences file of favourites and settings. Not the secure-storage file
  (its Keystore key stays on this phone) and not the outbox database. Keep in step
  with backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
